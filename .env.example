# ── ChargeBridge Portal — environment variables ───────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is git-ignored.

# ── API ───────────────────────────────────────────────────────────────────────

# Base URL of the ChargeBridge API (no trailing slash).
# Leave blank in dev to use the built-in mock fallback.
VITE_API_URL=https://api.chargebridge.io

# ── Host detection ────────────────────────────────────────────────────────────
#
# The single build is deployed to two subdomains. At runtime the app reads
# window.location.hostname and compares against these prefixes to decide
# which routing tree to activate.
#
# Rule: if hostname starts with VITE_CLIENT_HOST  → client portal tree
#        if hostname starts with VITE_OPERATOR_HOST → operator dashboard tree
#
# In local dev, append  ?_portal=client  or  ?_portal=operator  to any URL
# to override detection without changing these values.

VITE_CLIENT_HOST=portal        # → portal.chargebridge.io
VITE_OPERATOR_HOST=app         # → app.chargebridge.io

# ── Cross-host links ──────────────────────────────────────────────────────────
#
# Used when one host needs to link to the other (e.g. the operator dashboard
# header contains a "Client Portal" button that opens the portal host).

VITE_CLIENT_BASE_URL=https://portal.chargebridge.io
VITE_OPERATOR_BASE_URL=https://app.chargebridge.io

# ── Backend API (ChargeBridge Express server) ─────────────────────────────────
# URL of the running backend — no trailing slash
# In development: http://localhost:3000
# In production:  https://api.chargebridge.io  (or your deployed URL)
VITE_API_URL=http://localhost:3000
